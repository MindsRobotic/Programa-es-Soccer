#include <Wire.h>
#include <AFMotor.h>
#include <HTInfraredSeeker.h>

// Definição dos motores (ajuste as portas conforme sua montagem)
AF_DCMotor motor1(1);  // frente esquerdo
AF_DCMotor motor2(2);  // frente direito
AF_DCMotor motor3(3);  // trás esquerdo
AF_DCMotor motor4(4);  // trás direito

// Variáveis do sensor IR
int ballDirection;
int ballIntens;

// PID para rotação
float kp = 1.2;
float kd = 0.05;
float ki = 0.01;
float erroAnterior = 0;
float integral = 0;
float proporcional, derivativo;
float G;   // saída do PID (rotação)

// Controle de movimento
float Ft;  // avanço
float L;   // lateral
int mFE, mFD, mTE, mTD;

// Parâmetros ajustáveis
const int VEL_MAX = 200;       // velocidade máxima dos motores (0-255)
const int VEL_MIN = 70;        // velocidade mínima quando perto
const int VEL_BASE = 180;      // velocidade base de avanço
const float GANHO_LATERAL = 25;  // ganho para movimento lateral
const float DEADBAND = 0.5;    // zona morta para erro de direção

void setup() {
  Serial.begin(9600);
  Wire.begin();

  InfraredSeeker::Initialize();

  // Inicializa motores parados
  motor1.setSpeed(0);
  motor2.setSpeed(0);
  motor3.setSpeed(0);
  motor4.setSpeed(0);
  motor1.run(RELEASE);
  motor2.run(RELEASE);
  motor3.run(RELEASE);
  motor4.run(RELEASE);
}

void loop() {
  // Leitura do sensor IR
  InfraredResult InfraredBall = InfraredSeeker::ReadAC();
  ballDirection = InfraredBall.Direction;
  ballIntens = InfraredBall.Strength;

  // Log para debug
  Serial.print("Dir: ");
  Serial.print(ballDirection);
  Serial.print(" | Int: ");
  Serial.println(ballIntens);

  // Se a bola for detectada
  if (ballIntens > 0) {
    // 1. Calcula o erro de direção (0 = frente)
    float erro = ballDirection - 5;

    // 2. Calcula a rotação (PID)
    calcularPID(erro);

    // 3. Define a velocidade de avanço com base na intensidade (distância)
    //    Quanto maior a intensidade, mais perto a bola -> menor velocidade
    int velocidadeFt = map(ballIntens, 0, 200, VEL_BASE, VEL_MIN);
    velocidadeFt = constrain(velocidadeFt, VEL_MIN, VEL_BASE);
    Ft = velocidadeFt;

    // 4. Define o movimento lateral (proporcional ao erro, com deadband)
    if (abs(erro) > DEADBAND) {
      L = erro * GANHO_LATERAL;
      L = constrain(L, -100, 100);
    } else {
      L = 0;
    }
  } 
  else {
    // Bola não detectada: procura girando lentamente
    Ft = 0;
    L = 0;
    G = 50;   // gira para um lado (ajuste o sinal conforme necessário)
  }

  // Aplica a cinemática e move os motores
  calcularMotores();
  aplicarMotores();

  delay(30);  // loop em ~33Hz
}

// ========== PID para rotação ==========
void calcularPID(float erro) {
  proporcional = erro;
  integral += erro;
  derivativo = erro - erroAnterior;

  G = (kp * proporcional) + (ki * integral) + (kd * derivativo);

  // Limita a saída do PID
  G = constrain(G, -100, 100);

  // Anti-windup simples: se a saída estiver saturada, não acumula integral
  if ((G >= 100 && erro > 0) || (G <= -100 && erro < 0)) {
    integral -= erro;
  }

  erroAnterior = erro;
}

// ========== Cinemática omnidirecional (4 rodas a 45°) ==========
void calcularMotores() {
  mFE = Ft - L - G;
  mFD = Ft + L + G;
  mTE = Ft + L - G;
  mTD = Ft - L + G;

  // Garante que os valores não ultrapassem a faixa -255 a 255
  // (a função aplicarMotor já trata o sinal e o valor absoluto)
}

// ========== Aplica velocidades nos motores ==========
void aplicarMotores() {
  aplicarMotor(motor1, mFE);
  aplicarMotor(motor2, mFD);
  aplicarMotor(motor3, mTE);
  aplicarMotor(motor4, mTD);
}

void aplicarMotor(AF_DCMotor &motor, int vel) {
  vel = constrain(vel, -255, 255);
  if (vel > 0) {
    motor.run(FORWARD);
    motor.setSpeed(vel);
  } else if (vel < 0) {
    motor.run(BACKWARD);
    motor.setSpeed(-vel);
  } else {
    motor.run(RELEASE);
  }
}
